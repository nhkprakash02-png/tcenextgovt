# Copy this file to .env.local and fill in your Firebase project's config.
# (Values already have working fallback defaults in src/firebase.js matching the live
# tce-nahata project, but env vars are the safer long-term place to keep them.)
#
# NOTE: these were VITE_* under Vite. Next.js exposes browser-readable env vars via the
# NEXT_PUBLIC_ prefix instead — the values themselves are unchanged.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Razorpay ---
# Key ID is safe to expose to the browser (it's meant to be public — it's how Checkout knows
# which merchant account to open a payment for). Key SECRET must NEVER be prefixed with
# NEXT_PUBLIC_ and must never appear in any client-side code — it's what lets a server prove to
# Razorpay's API "I am really this merchant," and what lets our server verify a payment's
# signature is genuine and not forged by a tampered client. Get both from Razorpay Dashboard ->
# Account & Settings -> API Keys. Regenerate immediately if either is ever exposed anywhere
# (a chat log, a screenshot, a public repo, etc).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Firebase Admin (server-only) ---
# From Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
# This downloads a JSON file; copy its three fields below. This is what lets our server-side API
# routes write trusted enrollment data directly to Firestore, bypassing the client-side security
# rules entirely (which is correct here — these routes ARE the trusted authority, since they
# only write after independently verifying a real Razorpay payment happened). NEVER prefix these
# with NEXT_PUBLIC_ and never commit the actual values to source control.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# The private key contains literal newlines — when pasting into Vercel's env var UI, paste it
# exactly as it appears in the downloaded JSON (including \n escape sequences); firebaseAdmin.js
# converts those back to real newlines automatically.
FIREBASE_ADMIN_PRIVATE_KEY=
